{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"]
  },
  "importMap": "supabase/functions/import_map.json",
  "lint": {
    "files": {
      "include": ["supabase/functions/"]
    }
  },
  "fmt": {
    "files": {
      "include": ["supabase/functions/"]
    }
  },
  "tasks": {
    "start": "deno run --allow-net --allow-env --watch supabase/functions/index.ts"
  },
  "deno.enable": true,
  "deno.unstable": true
}